[control_plane]
%{ for i in masters ~}
${i.name} ansible_host=${i.public_ip} private_ip=${i.private_ip}
%{ endfor ~}

[workers]
%{ for i in workers ~}
${i.name} ansible_host=${i.public_ip} private_ip=${i.private_ip}
%{ endfor ~}

[ci]
%{ for i in ci ~}
${i.name} ansible_host=${i.public_ip} private_ip=${i.private_ip}
%{ endfor ~}

[k8s_cluster:children]
control_plane
workers

[all:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=${key_file}
