# Root module: wires three reusable modules together and hands the result to Ansible.
#   network  -> VPC, public subnets, internet gateway, routes
#   security -> security groups for the cluster and the CI server
#   compute  -> EC2 instances (control plane, workers, Jenkins)

locals {
  name = "${var.project_name}-${var.environment}"
}

data "aws_availability_zones" "available" {
  state = "available"
}

data "aws_ami" "ubuntu" {
  most_recent = true
  owners      = ["099720109477"] # Canonical

  filter {
    name   = "name"
    values = ["ubuntu/images/hvm-ssd-gp3/ubuntu-noble-24.04-amd64-server-*"]
  }
}

# SSH key pair generated by Terraform; the private key is written locally (git-ignored *.pem).
resource "tls_private_key" "ssh" {
  algorithm = "ED25519"
}

resource "aws_key_pair" "this" {
  key_name   = "${local.name}-key"
  public_key = tls_private_key.ssh.public_key_openssh
}

resource "local_sensitive_file" "private_key" {
  content         = tls_private_key.ssh.private_key_openssh
  filename        = "${path.module}/${local.name}.pem"
  file_permission = "0600"
}

module "network" {
  source = "./modules/network"

  name                = local.name
  vpc_cidr            = var.vpc_cidr
  public_subnet_cidrs = var.public_subnet_cidrs
  azs                 = slice(data.aws_availability_zones.available.names, 0, length(var.public_subnet_cidrs))
}

module "security" {
  source = "./modules/security"

  name       = local.name
  vpc_id     = module.network.vpc_id
  vpc_cidr   = var.vpc_cidr
  admin_cidr = var.admin_cidr
}

module "k8s_master" {
  source = "./modules/compute"

  name               = "${local.name}-master"
  instance_count     = 1
  role               = "control_plane"
  ami_id             = data.aws_ami.ubuntu.id
  instance_type      = var.master_instance_type
  subnet_ids         = module.network.public_subnet_ids
  security_group_ids = [module.security.cluster_sg_id]
  key_name           = aws_key_pair.this.key_name
  root_volume_size   = var.root_volume_size
}

module "k8s_workers" {
  source = "./modules/compute"

  name               = "${local.name}-worker"
  instance_count     = var.worker_count
  role               = "workers"
  ami_id             = data.aws_ami.ubuntu.id
  instance_type      = var.worker_instance_type
  subnet_ids         = module.network.public_subnet_ids
  security_group_ids = [module.security.cluster_sg_id]
  key_name           = aws_key_pair.this.key_name
  root_volume_size   = var.root_volume_size
}

module "jenkins" {
  source = "./modules/compute"

  name               = "${local.name}-jenkins"
  instance_count     = 1
  role               = "ci"
  ami_id             = data.aws_ami.ubuntu.id
  instance_type      = var.jenkins_instance_type
  subnet_ids         = module.network.public_subnet_ids
  security_group_ids = [module.security.ci_sg_id]
  key_name           = aws_key_pair.this.key_name
  root_volume_size   = 40
}

# Terraform -> Ansible hand-off: write the inventory with the real IPs.
resource "local_file" "ansible_inventory" {
  filename        = "${path.module}/../ansible/inventory/generated.ini"
  file_permission = "0644"
  content = templatefile("${path.module}/templates/inventory.tftpl", {
    masters  = module.k8s_master.instances
    workers  = module.k8s_workers.instances
    ci       = module.jenkins.instances
    key_file = abspath(local_sensitive_file.private_key.filename)
  })
}
