# Copy to jenkins/.env (git-ignored) and fill in. These become Jenkins credentials via JCasC.
JENKINS_URL=http://localhost:8081/
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=
JENKINS_DEV_PASSWORD=
DOCKERHUB_USER=
DOCKERHUB_TOKEN=
GITHUB_USER=
GITHUB_TOKEN=
SONAR_TOKEN=
SONAR_DB_PASSWORD=
SLACK_WEBHOOK_URL=
